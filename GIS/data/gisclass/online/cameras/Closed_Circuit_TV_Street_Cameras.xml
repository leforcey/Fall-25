        <lineage>
            <procstep>
                <procdesc>MPD CCTV camera was moved from Wisconsin Ave and Abelmarle St NW in 2D to Kalorama Road and Champlain Street NW in 3D.</procdesc>
                <procdate>20070816</procdate>
            </procstep>
            <procstep>
                <procdesc>Staff took the four files and combined their contents, geocoded them to the MAR, and hand placed the remainder to the basemap.</procdesc>
                <procdate>20080311</procdate>
            </procstep>
            <procstep>
                <procdesc>OCTO staff updated several new camera locations.</procdesc>
                <procdate>20081013</procdate>
            </procstep>
            <procstep>
                <procdesc>added 23 new DDOT cameras in I-395 tunnel.</procdesc>
                <procdate>20090305</procdate>
            </procstep>
            <procstep>
                <procdesc>Added 9 Trinidad (Safe City Project) camera locations at: 1. Bladensburg Road and Neal Street, Northeast 2. Montello Avenue and Queen Street, Northeast. 3. Montello Avenue and Morse Street, Northeast\ 4. Montello Avenue and Mount Olivet Road, Northeast 5. Mount Olivet Road and Trinidad Avenue, Northeast 6. Trinidad Avenue and Meigs Place, Northeast 7. Holbrook Street and Neal Street, Northeast 8. Holbrook Street and Levis Street, Northeast 9. Staples Street and Oats Street, Northeast</procdesc>
                <procdate>20100114</procdate>
            </procstep>
            <procstep>
                <procdesc>DC metropolitan police provided a comprehensive list of MPD cameras, 86 of which were located using a camera equipped with GPS. DC GIS staff replaced the 99 cameras originally in the layer with the updated 136 cameras from MPD. This includes red light cameras.</procdesc>
                <procdate>20100514</procdate>
            </procstep>
            <procstep>
                <procdesc>Staff updated the dataset using the latest information from DDOT.</procdesc>
                <procdate>20181026</procdate>
            </procstep>
            <procstep>
                <procdesc>Updated MPD cameras and added Ward and Police District</procdesc>
                <procdate>20231117</procdate>
            </procstep>
            <procstep>
                <procdesc>Added 50 MPD cameras.</procdesc>
                <procdate>20240719</procdate>
            </procstep>
            <procstep>
                <procdesc>Updated DDOT cameras.</procdesc>
                <procdate>20241122</procdate>
            </procstep>
            <procstep>
                <procdesc>Updated MPD CCTV from MPD website https://mpdc.dc.gov/page/mpdcs-closed-circuit-television-cctv-system</procdesc>
                <procdate>20250808</procdate>
            </procstep>
        </lineage>
